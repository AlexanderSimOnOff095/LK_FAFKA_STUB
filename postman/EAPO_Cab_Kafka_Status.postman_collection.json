{"info":{"name":"EAPO-Cab - Kafka status flow","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"List topics","request":{"method":"GET","url":"{{kafkaRestUrl}}/topics"}},{"name":"Publish status change REQUEST","event":[{"listen":"prerequest","script":{"exec":["pm.variables.set('eventId', pm.variables.replaceIn('{{$guid}}'));","pm.variables.set('requestId', 'req-' + pm.variables.replaceIn('{{$guid}}'));","pm.variables.set('occurredAt', new Date().toISOString());"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/vnd.kafka.json.v2+json"},{"key":"Accept","value":"application/vnd.kafka.v2+json"}],"body":{"mode":"raw","raw":"{\n  \"records\": [{\n    \"key\": \"{{applicationId}}\",\n    \"value\": {\n      \"eventId\": \"{{eventId}}\",\n      \"eventType\": \"APPLICATION_STATUS_CHANGE_REQUESTED\",\n      \"eventVersion\": 1,\n      \"occurredAt\": \"{{occurredAt}}\",\n      \"requestId\": \"{{requestId}}\",\n      \"correlationId\": \"{{requestId}}\",\n      \"producer\": \"eapo-cab\",\n      \"applicationId\": \"{{applicationId}}\",\n      \"currentStatus\": \"{{currentStatus}}\"\n    }\n  }]\n}"},"url":"{{kafkaRestUrl}}/topics/{{topic}}"}},{"name":"Create LK result consumer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/vnd.kafka.v2+json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"{{consumerInstance}}\",\n  \"format\": \"json\",\n  \"auto.offset.reset\": \"earliest\",\n  \"auto.commit.enable\": \"true\"\n}"},"url":"{{kafkaRestUrl}}/consumers/eapo-cab-status-result-v1"}},{"name":"Subscribe LK consumer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/vnd.kafka.v2+json"}],"body":{"mode":"raw","raw":"{\n  \"topics\": [\"{{topic}}\"]\n}"},"url":"{{kafkaRestUrl}}/consumers/eapo-cab-status-result-v1/instances/{{consumerInstance}}/subscription"}},{"name":"Read RESULT messages","request":{"method":"GET","header":[{"key":"Accept","value":"application/vnd.kafka.json.v2+json"}],"url":"{{kafkaRestUrl}}/consumers/eapo-cab-status-result-v1/instances/{{consumerInstance}}/records?timeout=10000&max_bytes=100000"}}]}
